# Shared, non-secret config used by docker-compose.yml to wire the
# backend and frontend containers together (ports, origins, build args).
# Service-specific secrets (DB credentials, session secret) stay in
# backend/.env — only values BOTH services or the compose file itself
# need to agree on belong here.

SERVER_PORT=3000
CLIENT_PORT=5173
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000
